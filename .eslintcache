eErrorCount":0,"fixableWarningCount":0},{"filePath":"91","messages":"92","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"93","messages":"94","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"95"},{"filePath":"96","messages":"97","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"98","messages":"99","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/jayyusi/OneDrive/Portfolio/weather-app/src/index.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/App.js",["100"],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/reportWebVitals.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/header.js",["101"],"import logo from '../logo.svg';\r\nimport { useEffect } from 'react';\r\nimport { Container, Row } from 'react-bootstrap';\r\nimport GlobalVariables from '../assets/global-variables';\r\nimport { useFetchGeolocation } from '../functions/useFetchGeolocation';\r\n\r\nconst Header = () => {\r\n  useFetchGeolocation(GlobalVariables.GEOLOCATION_DATABASE_CDN);\r\n  return (\r\n    <Container>\r\n      <Row className=\"header d-flex\">\r\n        <div className=\"logo\">\r\n          <img src={logo} alt=\"logo\" />\r\n        </div>\r\n        <div className=\"app-title-name ml-auto align-self-center\">\r\n          The Weather Network App\r\n        </div>\r\n      </Row>\r\n    </Container>\r\n  );\r\n};\r\n\r\nexport default Header;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/celsius-fahrenheit.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/weatherContext.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/empty-row.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/pages/current.js",["102","103","104","105"],"import CurrentWeather from '../components/current-weather';\r\nimport WeatherContext from '../components/weatherContext';\r\nimport { useEffect, useState, useContext } from 'react';\r\nimport GlobalVariables from '../assets/global-variables';\r\nimport initial_weather_data from '../response.json';\r\nimport { useFetchGeolocation } from '../functions/useFetchGeolocation';\r\n\r\nconst CurrentWeatherPage = () => {\r\n  const context = useContext(WeatherContext);\r\n  //console.log('context = ', context);\r\n  const weather = context.weather;\r\n\r\n  //useFetchGeolocation(GlobalVariables.GEOLOCATION_DATABASE_CDN);\r\n\r\n  //console.log('weather inside current.js =', weather);\r\n\r\n  if (context.isLoading) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Loading ...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (context.isError) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Error...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <CurrentWeather\r\n      timezone={weather.timezone.replace(/_/g, ' ')}\r\n      todays_date={new Date(weather.current.dt * 1e3).toLocaleDateString(\r\n        undefined,\r\n        GlobalVariables.OPTIONS\r\n      )}\r\n      time={new Date(weather.current.dt * 1e3).toLocaleTimeString()}\r\n      temp={Math.trunc(weather.current.temp)}\r\n      feels_like={Math.trunc(weather.current.feels_like)}\r\n      icon={\r\n        process.env.PUBLIC_URL +\r\n        '/icons/' +\r\n        weather.current.weather[0].icon +\r\n        '.svg'\r\n      }\r\n      description={weather.current.weather[0].main}\r\n      alerts={context.alert}\r\n    />\r\n  );\r\n};\r\n\r\nexport default CurrentWeatherPage;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/pages/hourly.js",["106","107","108"],"import { Container, Row, Col } from 'react-bootstrap';\r\nimport HourlyPagination from '../components/hourly-pagination';\r\nimport { useContext, useState } from 'react';\r\nimport WeatherContext from '../components/weatherContext';\r\nimport HourlyLegend from '../components/hourly-legend';\r\nimport HourlySinglePage from '../components/hourly-single-page';\r\nimport { useFetchGeolocation } from '../functions/useFetchGeolocation';\r\nimport GlobalVariables from '../assets/global-variables';\r\nconst Hourly = () => {\r\n  const context = useContext(WeatherContext);\r\n  const begin = context.paginationStartIndex;\r\n  const end = context.paginationEndIndex;\r\n  //console.log('context = ', context);\r\n  const weather = context.weather;\r\n  const hoursPerPage = GlobalVariables.HOURS_PER_PAGE;\r\n  //useFetchGeolocation(GlobalVariables.GEOLOCATION_DATABASE_CDN);\r\n  if (context.isLoading) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Loading ...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (context.hourlyIsMissing) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h5>\r\n          Hourly weather is currently unavailable for this location,\r\n          <br /> try a different location, e.g. Toronto, Ontario, Canada\r\n        </h5>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (context.isError) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Error...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <Container className=\"hourly-container\">\r\n      {weather && (\r\n        <h5 className=\"text-center m-3\">\r\n\t  {weather.timezone.replace(/_/g, ' ')} - 5 Day Forecast (3-hour steps)\r\n          {/* replace underscore with space */}\r\n        </h5>\r\n      )}\r\n      <Row className=\"hourly-row m-0\">\r\n        <HourlyLegend />\r\n        <HourlySinglePage weather={weather} begin={begin} end={end} />\r\n      </Row>\r\n\r\n      <HourlyPagination\r\n        active={(context.paginationEndIndex + 1) / hoursPerPage}\r\n      />\r\n    </Container>\r\n  );\r\n};\r\n\r\nexport default Hourly;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/pages/seven-days.js",["109"],"import NextSevenDays from '../components/next-7-days';\r\nimport { useContext } from 'react';\r\nimport WeatherContext from '../components/weatherContext';\r\nimport GlobalVariables from '../assets/global-variables';\r\nimport { useFetchGeolocation } from '../functions/useFetchGeolocation';\r\nconst SevenDaysPage = () => {\r\n  const context = useContext(WeatherContext);\r\n  //console.log('context = ', context);\r\n  const weather = context.weather;\r\n  //useFetchGeolocation(GlobalVariables.GEOLOCATION_DATABASE_CDN);\r\n  if (context.isLoading) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Loading ...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (context.isError) {\r\n    return (\r\n      <div className=\"text-center\">\r\n        <h1>Error...</h1>\r\n      </div>\r\n    );\r\n  }\r\n\tlet days = [];\r\n\tconst dayCount = Math.min(7, weather.daily.length - 1);\r\n\tfor (let i = 1; i <= dayCount; i++) {\r\n\t  \r\n    days.push({\r\n      date: new Date(weather.daily[i].dt * 1e3).toLocaleDateString(\r\n        undefined,\r\n        GlobalVariables.OPTIONS\r\n      ),\r\n      condition: weather.daily[i].weather[0].main,\r\n      icon:\r\n        process.env.PUBLIC_URL +\r\n        '/icons/' +\r\n        weather.daily[i].weather[0].icon +\r\n        '.svg',\r\n      temp: Math.trunc(weather.daily[i].temp.day),\r\n      feels_like: Math.trunc(weather.daily[i].feels_like.day),\r\n      wind_speed: Math.trunc(weather.daily[i].wind_speed),\r\n      wind_deg: weather.daily[i].wind_deg,\r\n    });\r\n  }\r\n\r\n  return <NextSevenDays days={days} />;\r\n};\r\n\r\nexport default SevenDaysPage;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/pages/error.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/pages/navbar.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/current-weather.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/hourly-pagination.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/hourly-legend.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/hourly-single-page.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/next-7-days.js",["110","111"],"import { Container, Row, Col } from 'react-bootstrap';\r\nimport Day from './day';\r\nimport { useContext } from 'react';\r\nimport { useFetchGeolocation } from '../functions/useFetchGeolocation';\r\nimport WeatherContext from '../components/weatherContext';\r\nimport GlobalVariables from '../assets/global-variables';\r\nconst Next_Seven_Days = (props) => {\r\n  const context = useContext(WeatherContext);\r\n  const weather = context.weather;\r\n  // useFetchGeolocation(GlobalVariables.GEOLOCATION_DATABASE_CDN);\r\n  const days = props.days;\r\n  //console.log('days =', days);\r\n  return (\r\n    <Container>\r\n      {weather && (\r\n        <h5 className=\"text-center m-3\">\r\n          {weather.timezone.replace(/_/g, ' ')} - Next 5 Days\r\n        </h5>\r\n      )}\r\n      <Row className=\"m-0\">\r\n        <div className=\"d-flex align-items-end\">\r\n          <Col className=\"legend p-2\">\r\n            <div>Feels like</div>\r\n            <div>Wind</div>\r\n            <div>Wind deg.</div>\r\n          </Col>\r\n        </div>\r\n\r\n        {days.map((day) => (\r\n          <Col className=\"day-column\">\r\n            <Day\r\n              name={day.date}\r\n              date={day.condition}\r\n              icon={day.icon}\r\n              temp={day.temp}\r\n              feels_like={day.feels_like}\r\n              wind_speed={day.wind_speed}\r\n              wind_deg={day.wind_deg}\r\n            />\r\n          </Col>\r\n        ))}\r\n      </Row>\r\n    </Container>\r\n  );\r\n};\r\n\r\nexport default Next_Seven_Days;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/functions/useFetchGeolocation.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/assets/global-variables.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/form.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/hourly-weather.js",["112"],"import { Row, Col } from 'react-bootstrap';\r\n\r\nconst HourlyWeather = (props) => {\r\n  const hourly = props.hourly;\r\n  return (\r\n    <>\r\n      {hourly.map((hour) => (\r\n        <Col className=\"hourly-column\">\r\n          <ul>\r\n            <li>\r\n              <b>{hour.day}</b>\r\n            </li>\r\n            <li>{hour.time}</li>\r\n            <li>{hour.description}</li>\r\n            <li>\r\n              {hour.icon && (\r\n                <img id=\"weatherIcon\" src={hour.icon} alt=\"weather icon\" />\r\n              )}\r\n            </li>\r\n            <li>\r\n              <b>{hour.temp} </b> <sup>°</sup>C\r\n            </li>\r\n            <li>{hour.main}</li>\r\n            <li className=\"text-white\">{hour.sep}</li>\r\n            <div className=\"hourly-white-box\">\r\n              <li>\r\n                {hour.feels_like} <sup>°</sup>C\r\n              </li>\r\n              <li>\r\n                {hour.pressure} <sup>hPa</sup>\r\n              </li>\r\n              <li>\r\n                {hour.humidity} <sup>%</sup>\r\n              </li>\r\n\t\t<li>\r\n\t\t  {hour.dew_point ?? 'N/A'} <sup>°</sup>\r\n\t\t</li>\r\n\t\t<li>{hour.uvi ?? 'N/A'}</li>\r\n              <li>\r\n                {hour.clouds} <sup>%</sup>\r\n              </li>\r\n              <li>\r\n                {hour.visibility} <sup>km</sup>\r\n              </li>\r\n              <li>\r\n                {hour.wind_speed} <sup>km/h</sup>\r\n              </li>\r\n              <li>\r\n                {hour.wind_deg} <sup>°</sup>\r\n              </li>\r\n              <li>\r\n                {hour.pop} <sup>%</sup>\r\n              </li>\r\n            </div>\r\n          </ul>\r\n        </Col>\r\n      ))}\r\n    </>\r\n  );\r\n};\r\n\r\nexport default HourlyWeather;\r\n","/home/jayyusi/OneDrive/Portfolio/weather-app/src/components/day.js",[],"/home/jayyusi/OneDrive/Portfolio/weather-app/src/functions/weatherDataBuilder.js",[],{"ruleId":"113","severity":1,"message":"114","line":8,"column":27,"nodeType":"115","messageId":"116","endLine":8,"endColumn":36},{"ruleId":"113","severity":1,"message":"114","line":2,"column":10,"nodeType":"115","messageId":"116","endLine":2,"endColumn":19},{"ruleId":"113","severity":1,"message":"114","line":3,"column":10,"nodeType":"115","messageId":"116","endLine":3,"endColumn":19},{"ruleId":"113","severity":1,"message":"117","line":3,"column":21,"nodeType":"115","messageId":"116","endLine":3,"endColumn":29},{"ruleId":"113","severity":1,"message":"118","line":5,"column":8,"nodeType":"115","messageId":"116","endLine":5,"endColumn":28},{"ruleId":"113","severity":1,"message":"119","line":6,"column":10,"nodeType":"115","messageId":"116","endLine":6,"endColumn":29},{"ruleId":"113","severity":1,"message":"120","line":1,"column":26,"nodeType":"115","messageId":"116","endLine":1,"endColumn":29},{"ruleId":"113","severity":1,"message":"117","line":3,"column":22,"nodeType":"115","messageId":"116","endLine":3,"endColumn":30},{"ruleId":"113","severity":1,"message":"119","line":7,"column":10,"nodeType":"115","messageId":"116","endLine":7,"endColumn":29},{"ruleId":"113","severity":1,"message":"119","line":5,"column":10,"nodeType":"115","messageId":"116","endLine":5,"endColumn":29},{"ruleId":"113","severity":1,"message":"119","line":4,"column":10,"nodeType":"115","messageId":"116","endLine":4,"endColumn":29},{"ruleId":"113","severity":1,"message":"121","line":6,"column":8,"nodeType":"115","messageId":"116","endLine":6,"endColumn":23},{"ruleId":"113","severity":1,"message":"122","line":1,"column":10,"nodeType":"115","messageId":"116","endLine":1,"endColumn":13},"no-unused-vars","'useEffect' is defined but never used.","Identifier","unusedVar","'useState' is defined but never used.","'initial_weather_data' is defined but never used.","'useFetchGeolocation' is defined but never used.","'Col' is defined but never used.","'GlobalVariables' is defined but never used.","'Row' is defined but never used."]